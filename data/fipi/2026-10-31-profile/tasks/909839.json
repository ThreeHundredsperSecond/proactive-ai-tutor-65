splaystyle=\"true\"> <semantics> <mrow> <mi>C</mi><mi>D</mi><mo>:</mo><mi>D</mi><mi>N</mi> </mrow>  </semantics> </mstyle></math>, если <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mstyle displaystyle=\"true\"> <semantics> <mrow> <mi>A</mi><mi>B</mi><mo>:</mo><mi>B</mi><mi>C</mi><mo>=</mo><mn>1</mn><mo>:</mo><mn>2</mn> </mrow>  </semantics> </mstyle></math>, а <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mstyle displaystyle=\"true\"> <semantics> <mrow> <mi>cos</mi><mo>∠</mo><mi>B</mi><mi>A</mi><mi>D</mi><mo>=</mo><mfrac> <mn>2</mn> <mn>3</mn> </mfrac> </mrow>  </semantics> </mstyle></math>.</p> <p class=\"MsoNormal\"><span> </span></p>  </section></div>",
